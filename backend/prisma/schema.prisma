datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model UserMetric {
  id           String   @id @default(uuid())
  userName     String
  secretToken  String   @unique
  serverStatus String
  createdAt    DateTime @default(now())
}

model BackgroundJob {
  id           String   @id @default(uuid())
  taskTitle    String
  status       String   
  dispatchedAt DateTime @default(now())
  completedAt  DateTime?
}